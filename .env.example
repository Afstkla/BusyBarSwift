# Device access key (4-10 digits), set on the bar under Settings > HTTP API access.
# Sent as the X-API-Token header to a device on your LAN or over USB.
BUSYBAR_TOKEN=

# Optional. Defaults to the USB-ethernet address the bar exposes.
BUSYBAR_HOST=http://10.0.4.20

# BUSY Cloud BAR-scope token, sent as Authorization: Bearer to https://api.busy.app.
# Reaches the bar wherever it is, without being on the same network.
BUSYBAR_CLOUD_TOKEN=
